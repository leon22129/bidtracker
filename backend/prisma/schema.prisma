// Prisma schema — PostgreSQL.
// Enum-like fields remain strings so API constants and DTO validation stay the application source of
// truth. Migration 20260924030000 mirrors those values with PostgreSQL CHECK constraints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  aiSettings AiSettings?
  id                   String    @id @default(cuid())
  username             String    @unique
  email                String    @unique
  password_hash        String
  role                 String    @default("bidder") // super_admin | admin | bidder_manager | bidder
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  created_by_user_id   String?
  manager_user_id      String?
  slack_webhook_url    String?
  slack_user_id        String?
  slack_milestone_day  DateTime?
  slack_last_milestone Int       @default(0)

  ownedWorkspaces          Workspace[]          @relation("WorkspaceOwner")
  managedWorkspaces        Workspace[]          @relation("WorkspaceManager")
  createdWorkspaces        Workspace[]          @relation("WorkspaceCreator")
  createdUsers             User[]               @relation("UserCreator")
  managedBidders           User[]               @relation("BidderManagerAssignments")
  createdApplications      JobApplication[]     @relation("CreatedBy")
  processedPaymentReports  PaymentReport[]      @relation("ProcessedBy")
  bidderPaymentReports     PaymentReport[]      @relation("BidderPaymentReports")
  createdBannedUrlPatterns BannedUrlPattern[]   @relation("BannedUrlPatternCreator")
  resumeConversations      ResumeConversation[]
  creator                  User?                @relation("UserCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  manager                  User?                @relation("BidderManagerAssignments", fields: [manager_user_id], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([created_by_user_id])
  @@index([manager_user_id])
  @@map("users")
  applicationDrafts ApplicationDraft[]
}

// ---------------------------------------------------------------------------
// Workspace (a "tab", e.g. "John Applications")
// The owner controls the current assignment. Payment attribution is immutable on each application.
// ---------------------------------------------------------------------------
model Workspace {
  id                 String   @id @default(cuid())
  name               String   @unique
  owner_user_id      String
  manager_user_id    String?
  created_by_user_id String?
  is_archived        Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Restrict: a user who owns a workspace cannot be deleted — payment attribution must survive.
  owner               User                 @relation("WorkspaceOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  manager             User?                @relation("WorkspaceManager", fields: [manager_user_id], references: [id], onDelete: SetNull)
  creator             User?                @relation("WorkspaceCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  applications        JobApplication[]
  resumeProfile       ResumeProfile?
  resumeConversations ResumeConversation[]

  @@index([owner_user_id])
  @@index([manager_user_id])
  @@index([created_by_user_id])
  @@index([is_archived])
  @@map("workspaces")
  applicationDrafts ApplicationDraft[]
}

// A workspace-owned resume-builder profile. workspace_id is unique, so profiles cannot be shared.
model ResumeProfile {
  id                        String   @id @default(cuid())
  workspace_id              String   @unique
  name                      String
  career_path               String   @default("")
  full_name                 String   @default("")
  first_name                String   @default("")
  middle_name               String   @default("")
  last_name                 String   @default("")
  title                     String   @default("")
  email                     String   @default("")
  phone                     String   @default("")
  location                  String   @default("")
  country                   String   @default("")
  address1                  String   @default("")
  city                      String   @default("")
  county                    String   @default("")
  state                     String   @default("")
  zip                       String   @default("")
  linkedin                  String   @default("")
  gender                    String   @default("")
  hispanic_latino           String   @default("")
  ethnicity                 String   @default("")
  requires_sponsorship      String   @default("")
  legally_authorized_us     String   @default("")
  us_work_status            String   @default("")
  update_headline           Boolean  @default(true)
  use_generated_role_titles Boolean  @default(true)
  template                  String   @default("classic")
  save_in_folder            Boolean  @default(false)
  auto_download             Boolean  @default(false)
  download_jd_with_pdf      Boolean  @default(false)
  use_company_name          Boolean  @default(true)
  generate_cover_letter     Boolean  @default(false)
  cover_letter_template     String   @default("classic")
  education_json            String   @default("[]")
  certifications_json       String   @default("[]")
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  resumeConversations ResumeConversation[]

  @@map("resume_profiles")
}

// Compact local context for application questions. Legacy rows retain their remote OpenAI id;
// new rows use local_<uuid>. The public id is always this row's id.
model ResumeConversation {
  reference_context      String?
  id                     String   @id @default(cuid())
  openai_conversation_id String   @unique
  user_id                String
  workspace_id           String?
  profile_id             String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user         User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace    Workspace?       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  profile      ResumeProfile    @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([user_id])
  @@index([workspace_id])
  @@index([profile_id])
  @@index([updated_at])
  @@map("resume_conversations")
  draft ApplicationDraft?
}

model AiSettings {
  resume_prompt String?
  admin_id String @id
  provider String @default("openai")
  model String @default("gpt-6.1-sol")
  openai_key String?
  deepseek_key String?
  updated_at DateTime @updatedAt
  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// ---------------------------------------------------------------------------
// JobApplication — the main table (50k+ rows per workspace)
// ---------------------------------------------------------------------------
model JobApplication {
  id           String @id @default(cuid())
  workspace_id String

  // Day bucket, always normalised to UTC midnight. `number` restarts at 1 for each (workspace, date).
  date   DateTime
  number Int

  job_title       String?
  company_name    String? // for duplicate matching and display
  url             String
  normalized_url  String // canonical form — URL duplicate key
  job_fingerprint String? // recent workspace duplicate signal: normalized company + title
  job_source      String  @default("Other")

  application_status String    @default("Pending") // Pending | Applied | Cancelled | Rejected | Banned | Duplicated
  pipeline_status    String    @default("Not Started") // admin-managed recruiting stage
  interview_date     DateTime?
  interview_note     String?

  note String?

  paid Boolean @default(false)

  // Durable generation artifacts. The conversation is temporary and may be deleted by retention;
  // the resume snapshot and JD remain so the exact files can be downloaded later.
  conversation_id            String?
  job_description            String?
  generated_resume_json      String?
  resume_template            String?
  resume_generated_at        DateTime?
  cover_letter_text          String?
  cover_letter_template      String?
  application_questions_json String?
  application_answers_json   String?

  // Immutable payment subject: the bidder who created/performed this application.
  created_by_user_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace     Workspace           @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  createdByUser User                @relation("CreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)
  conversation  ResumeConversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  screenshot    ApplicationScreenshot?

  // Guarantees the "number resets per date" invariant at the storage layer, and doubles as the
  // covering index for the default table sort (date desc, number asc).
  @@unique([workspace_id, date, number])
  @@index([workspace_id, application_status, date, number, id], map: "job_applications_sort_application_status_idx")
  @@index([workspace_id, pipeline_status, date, number, id], map: "job_applications_sort_pipeline_status_idx")
  @@index([workspace_id, job_source, date, number, id], map: "job_applications_sort_job_source_idx")
  @@index([workspace_id, paid, date, number, id], map: "job_applications_sort_paid_idx")
  @@index([workspace_id, number, date, id], map: "job_applications_sort_number_idx")
  @@index([workspace_id, job_title, date, number, id], map: "job_applications_sort_job_title_idx")
  @@index([workspace_id, company_name, date, number, id], map: "job_applications_sort_company_name_idx")
  @@index([workspace_id, interview_date, date, number, id], map: "job_applications_sort_interview_date_idx")
  // PostgreSQL enforces a partial unique index on (workspace_id, normalized_url) for Pending/Applied
  // rows. Prisma schema syntax cannot represent partial indexes, so keep that invariant in SQL.
  @@index([workspace_id, normalized_url])
  @@index([workspace_id, job_fingerprint, created_at])
  @@index([date])
  @@index([interview_date])
  @@index([workspace_id, created_at, date, number, id], map: "job_applications_sort_created_at_idx")
  @@index([created_by_user_id, created_at])
  @@index([conversation_id])
  // Migration 20260924030000 adds pg_trgm GIN indexes for job_title, company_name, url, and note.
  // Payment and latest-generated lookups use smaller PostgreSQL partial indexes defined in SQL.
  // Prisma cannot represent partial indexes in schema syntax.
  @@index([workspace_id, date(sort: Desc), number(sort: Asc)], map: "job_applications_workspace_date_desc_number_asc_idx")
  @@map("job_applications")
  submissionDraft ApplicationDraft?
}

model ApplicationScreenshot {
  application_id String   @id
  image_data     Bytes
  content_type   String   @default("image/png")
  captured_at    DateTime @default(now())
  expires_at     DateTime

  application JobApplication @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("application_screenshots")
}

// ---------------------------------------------------------------------------
// PaymentReport — immutable history of an admin processing an unpaid period.
// ---------------------------------------------------------------------------
model PaymentReport {
  id            String   @id @default(cuid())
  bidder_id     String
  start_date    DateTime
  end_date      DateTime
  applied_count Int
  processed_by  String?
  processed_at  DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  bidder    User  @relation("BidderPaymentReports", fields: [bidder_id], references: [id], onDelete: Restrict)
  processor User? @relation("ProcessedBy", fields: [processed_by], references: [id], onDelete: SetNull)

  @@index([bidder_id, start_date, end_date])
  @@index([processed_at])
  @@index([processed_by, processed_at(sort: Desc)])
  @@map("payment_reports")
}

model BannedUrlPattern {
  id                 String   @id @default(cuid())
  pattern            String   @unique
  created_by_user_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  createdByUser User? @relation("BannedUrlPatternCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([created_by_user_id])
  @@map("banned_url_patterns")
}

// Prepared jobs are separate from submitted applications and payment counts.
model ApplicationDraft {
  id String @id @default(cuid())
  workspace_id String
  created_by_user_id String
  url String
  normalized_url String
  company_name String
  job_title String
  source_job_description String
  job_description String
  generated_resume_json String
  resume_template String @default("classic")
  cover_letter_text String?
  cover_letter_template String @default("classic")
  conversation_id String? @unique
  application_questions_json String?
  application_answers_json String?
  submitted_application_id String? @unique
  submitted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator User @relation(fields: [created_by_user_id], references: [id], onDelete: Cascade)
  conversation ResumeConversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  application JobApplication? @relation(fields: [submitted_application_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_by_user_id, created_at])
  @@map("application_drafts")
}
