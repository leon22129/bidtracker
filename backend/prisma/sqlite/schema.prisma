// Prisma schema — SQLite.
//
// NOTE ON ENUMS: SQLite has no native enum type and Prisma therefore rejects `enum` blocks for this
// provider. Every "enum" column below is a String whose allowed values live in
// `src/common/constants.ts` and are enforced at the DTO boundary with `@IsIn(...)`.
// This keeps the schema portable: switching `provider` to "postgresql" requires no column changes.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  email              String   @unique
  password_hash      String
  role               String   @default("bidder") // super_admin | admin | bidder_manager | bidder
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  created_by_user_id String?

  ownedWorkspaces          Workspace[]          @relation("WorkspaceOwner")
  createdWorkspaces        Workspace[]          @relation("WorkspaceCreator")
  createdUsers             User[]               @relation("UserCreator")
  resumeProfiles           ResumeProfile[]
  createdResumeProfiles    ResumeProfile[]      @relation("ResumeProfileCreator")
  createdApplications      JobApplication[]     @relation("CreatedBy")
  processedPaymentReports  PaymentReport[]      @relation("ProcessedBy")
  bidderPaymentReports     PaymentReport[]      @relation("BidderPaymentReports")
  createdBannedUrlPatterns BannedUrlPattern[]   @relation("BannedUrlPatternCreator")
  resumeConversations      ResumeConversation[]
  creator                  User?                @relation("UserCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([created_by_user_id])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Workspace (a "tab", e.g. "John Applications")
// The owner controls the current assignment. Payment attribution is immutable on each application.
// ---------------------------------------------------------------------------
model Workspace {
  id                 String   @id @default(cuid())
  name               String   @unique
  owner_user_id      String
  created_by_user_id String?
  is_archived        Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  // Restrict: a user who owns a workspace cannot be deleted — payment attribution must survive.
  owner               User                 @relation("WorkspaceOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  creator             User?                @relation("WorkspaceCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  applications        JobApplication[]
  resume_profile_id   String?
  resumeProfile       ResumeProfile?       @relation(fields: [resume_profile_id], references: [id], onDelete: SetNull)
  resumeConversations ResumeConversation[]

  @@index([owner_user_id])
  @@index([created_by_user_id])
  @@index([is_archived])
  @@index([resume_profile_id])
  @@map("workspaces")
}

// A resume-builder profile assigned to one bid-tracker user.
model ResumeProfile {
  id                        String   @id @default(cuid())
  user_id                   String
  created_by_user_id        String?
  name                      String
  career_path               String   @default("")
  full_name                 String   @default("")
  title                     String   @default("")
  email                     String   @default("")
  phone                     String   @default("")
  location                  String   @default("")
  linkedin                  String   @default("")
  update_headline           Boolean  @default(true)
  use_generated_role_titles Boolean  @default(true)
  template                  String   @default("classic")
  save_in_folder            Boolean  @default(false)
  auto_download             Boolean  @default(false)
  download_jd_with_pdf      Boolean  @default(false)
  use_company_name          Boolean  @default(true)
  generate_cover_letter     Boolean  @default(false)
  cover_letter_template     String   @default("classic")
  education_json            String   @default("[]")
  certifications_json       String   @default("[]")
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  user                User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  creator             User?                @relation("ResumeProfileCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  workspaces          Workspace[]
  resumeConversations ResumeConversation[]

  @@unique([user_id, name])
  @@index([user_id])
  @@index([created_by_user_id])
  @@map("resume_profiles")
}

// Server-owned mapping to a compact OpenAI conversation used only for
// application questions. The public id is this row's id, never the provider id.
model ResumeConversation {
  id                     String   @id @default(cuid())
  openai_conversation_id String   @unique
  user_id                String
  workspace_id           String?
  profile_id             String
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user      User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace?    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  profile   ResumeProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([workspace_id])
  @@index([profile_id])
  @@map("resume_conversations")
}

// ---------------------------------------------------------------------------
// JobApplication — the main table (50k+ rows per workspace)
// ---------------------------------------------------------------------------
model JobApplication {
  id           String @id @default(cuid())
  workspace_id String

  // Day bucket, always normalised to UTC midnight. `number` restarts at 1 for each (workspace, date).
  date   DateTime
  number Int

  job_title       String?
  company_name    String? // for duplicate matching and display
  url             String
  normalized_url  String // canonical form — URL duplicate key
  job_fingerprint String? // recent workspace duplicate signal: normalized company + title
  job_source      String  @default("Other")

  application_status String @default("Pending") // Pending | Applied | Rejected | Duplicated
  pipeline_status    String @default("Not Started") // admin-managed recruiting stage

  note String?

  paid Boolean @default(false)

  // Immutable payment subject: the bidder who created/performed this application.
  created_by_user_id String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  createdByUser User      @relation("CreatedBy", fields: [created_by_user_id], references: [id], onDelete: Restrict)

  // Guarantees the "number resets per date" invariant at the storage layer, and doubles as the
  // covering index for the default table sort (date desc, number desc).
  @@unique([workspace_id, date, number])
  @@index([workspace_id, application_status])
  @@index([workspace_id, pipeline_status])
  @@index([workspace_id, job_source])
  @@index([workspace_id, paid])
  @@index([normalized_url])
  @@index([workspace_id, job_fingerprint, created_at])
  @@index([date])
  @@index([workspace_id, created_at])
  @@index([application_status, paid, date, created_by_user_id, workspace_id], map: "job_applications_payment_lookup_idx")
  @@index([workspace_id, date(sort: Desc), number(sort: Asc)], map: "job_applications_workspace_date_desc_number_asc_idx")
  @@map("job_applications")
}

// ---------------------------------------------------------------------------
// PaymentReport — immutable history of an admin processing an unpaid period.
// ---------------------------------------------------------------------------
model PaymentReport {
  id            String   @id @default(cuid())
  bidder_id     String
  start_date    DateTime
  end_date      DateTime
  applied_count Int
  processed_by  String?
  processed_at  DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  bidder    User  @relation("BidderPaymentReports", fields: [bidder_id], references: [id], onDelete: Restrict)
  processor User? @relation("ProcessedBy", fields: [processed_by], references: [id], onDelete: SetNull)

  @@index([bidder_id, start_date, end_date])
  @@index([processed_at])
  @@map("payment_reports")
}

model BannedUrlPattern {
  id                 String   @id @default(cuid())
  pattern            String   @unique
  created_by_user_id String?
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  createdByUser User? @relation("BannedUrlPatternCreator", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  @@index([created_by_user_id])
  @@map("banned_url_patterns")
}
