{
  "name": "bidtracker-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "description": "NestJS API for the job application / bidder tracking system",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node scripts/dev.mjs",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "prisma generate --schema prisma/sqlite/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prebuild": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:company-cooldown": "node scripts/check-company-cooldown.cjs",
    "test:application-workflow": "node scripts/check-application-workflow.cjs",
    "check:ai": "node scripts/check-openai-connection.cjs",
    "smoke": "node smoke.mjs",
    "perf": "node perf.mjs",
    "template": "node make-import-template.cjs",
    "backfill:fingerprints": "ts-node scripts/backfill-job-fingerprints.ts",
    "migrate:sqlite-to-postgres": "prisma generate && prisma generate --schema prisma/sqlite/schema.prisma && ts-node scripts/migrate-sqlite-to-postgres.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ES2022",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test-setup.ts"
    ],
    "testEnvironment": "node"
  }
}
