# ---------------------------------------------------------------------------
# BidTracker configuration.
#
#   cp .env.example backend/.env
#   then edit DATABASE_URL, JWT_SECRET, and DEFAULT_ADMIN_PASSWORD below.
#
# .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Signs every JWT. Changing it invalidates all sessions (a blunt but effective
# "log everyone out"). Generate one:
#   openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

# First-boot admin. These are read ONLY when the database contains zero admin
# users, so:
#   - the admin can change their password in the UI and a restart won't revert it
#   - no duplicate default admin is ever created
#   - the password is hashed with bcrypt before it touches the database and is
#     never returned by any API endpoint
# Change the password after the first login, then you may clear this value.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-at-least-8-chars

# Server-side OpenAI access used by the resume generation endpoint. Never put
# this value in frontend environment variables or commit it to source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Structured backend logging. AI prompts/responses can contain resumes and job
# descriptions, so their text is excluded by default. If explicitly enabled,
# previews are truncated to the configured limit.
LOG_LEVEL=info
LOG_RETENTION_DAYS=30
AI_LOG_CONTENT=false
AI_LOG_CONTENT_MAX_CHARS=2000

# Provider conversations are deleted daily after this many inactive days. The
# local mapping is retained for retry when provider deletion fails.
OPENAI_CONVERSATION_RETENTION_DAYS=90
DISABLE_CONVERSATION_CLEANUP=false

# OpenAI returns token counts, not dollar costs. Set the current USD rates for
# OPENAI_MODEL (per one million tokens) to include input/output/total estimates
# in each openai_request_completed log event. Cached input falls back to the
# regular input rate when its dedicated rate is left empty.
OPENAI_INPUT_COST_PER_1M_TOKENS=4
OPENAI_CACHED_INPUT_COST_PER_1M_TOKENS=0.4
OPENAI_OUTPUT_COST_PER_1M_TOKENS=20

# PostgreSQL connection used directly by Prisma.
DATABASE_URL=postgresql://bidtracker:YOUR_PASSWORD@127.0.0.1:5432/bidtracker?schema=public


# === OPTIONAL — session ====================================================

# Accepts ms-style durations: 30m, 12h, 7d.
JWT_EXPIRES_IN=7d


# === OPTIONAL — behaviour ==================================================

# Exact URL duplicates are global and enforced by PostgreSQL for payment integrity.

# Treat the same normalized company + job title in one workspace as a possible
# cross-site duplicate for this many days. The user may explicitly override it.
JOB_FINGERPRINT_WINDOW_DAYS=90

# Upload ceiling for Excel/CSV import, in megabytes.
MAX_UPLOAD_MB=25

# XLSX is a ZIP format. These limits apply before ExcelJS loads the workbook and
# prevent a small compressed upload from expanding until memory is exhausted.
MAX_XLSX_EXPANDED_MB=100
MAX_XLSX_ZIP_ENTRIES=2000

# Skip the Monday 00:05 UTC weekly settlement job. Set true on a staging copy so
# it can't produce reports that look authoritative.
DISABLE_CRON=false

# Lets bidders move Pending -> Rejected directly. The spec only requires
# Pending -> Applied and Applied -> Rejected, so this is off by default.
ALLOW_BIDDER_PENDING_TO_REJECTED=false


# === OPTIONAL — networking =================================================

# Leave NEXT_PUBLIC_API_BASE_URL and CORS_ORIGINS empty for the default single-hostname deployment: the
# browser calls /api/* on the frontend's own origin and Next proxies it to the
# backend through the frontend's same-origin proxy. No CORS is involved.
# The frontend server uses BACKEND_URL for that proxy target.
#
# Only set them if the API is served from a different hostname:
#   NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#   CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=
BACKEND_URL=http://127.0.0.1:3001


# === LOCAL DEVELOPMENT ONLY ================================================
# The backend reads DATABASE_URL from backend/.env when started with `npm run start:dev`.
# Start a local PostgreSQL service, then use:
#   DATABASE_URL="postgresql://bidtracker:YOUR_PASSWORD@127.0.0.1:5432/bidtracker?schema=public"
