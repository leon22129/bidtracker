# ---------------------------------------------------------------------------
# BidTracker configuration.
#
#   cp .env.example .env      then edit the two REQUIRED values below.
#
# .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# Signs every JWT. Changing it invalidates all sessions (a blunt but effective
# "log everyone out"). Generate one:
#   openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

# First-boot admin. These are read ONLY when the database contains zero admin
# users, so:
#   - the admin can change their password in the UI and a restart won't revert it
#   - no duplicate default admin is ever created
#   - the password is hashed with bcrypt before it touches the database and is
#     never returned by any API endpoint
# Change the password after the first login, then you may clear this value.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-at-least-8-chars


# === OPTIONAL — session ====================================================

# Accepts ms-style durations: 30m, 12h, 7d.
JWT_EXPIRES_IN=7d


# === OPTIONAL — behaviour ==================================================

# global    = a URL already present in ANY workspace counts as a duplicate.
#             Correct when several bidders share one pool of companies, which is
#             the normal case, and it's what protects the payment count.
# workspace = duplicates are only detected within the same tab.
DUPLICATE_SCOPE=global

# Fetch each pasted URL to read <title>/og: tags for company + job title.
# Off makes pasting instant but leaves more blanks for manual entry. Failures
# never block an insert either way.
ENABLE_URL_ENRICHMENT=true
URL_FETCH_CONCURRENCY=5
URL_FETCH_TIMEOUT_MS=6000

# Upload ceiling for Excel/CSV import, in megabytes.
MAX_UPLOAD_MB=25

# Skip the Monday 00:05 UTC weekly settlement job. Set true on a staging copy so
# it can't produce reports that look authoritative.
DISABLE_CRON=false

# Lets bidders move Pending -> Rejected directly. The spec only requires
# Pending -> Applied and Applied -> Rejected, so this is off by default.
ALLOW_BIDDER_PENDING_TO_REJECTED=false


# === OPTIONAL — networking =================================================

# Leave BOTH of these empty for the default single-hostname deployment: the
# browser calls /api/* on the frontend's own origin and Next proxies it to the
# backend over the internal Docker network. No CORS is involved.
#
# Only set them if the API is served from a different hostname:
#   NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#   CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=


# === OPTIONAL — Cloudflare Tunnel ==========================================

# Only needed with:  docker compose --profile tunnel up -d
# Create a tunnel at one.dash.cloudflare.com -> Networks -> Tunnels, route its
# public hostname to http://frontend:3000, and paste the token here.
CLOUDFLARE_TUNNEL_TOKEN=


# === LOCAL DEVELOPMENT ONLY ================================================
# When running the backend outside Docker (`npm run start:dev`), it reads
# DATABASE_URL from backend/.env instead. Use:
#   DATABASE_URL="file:./dev.db"
